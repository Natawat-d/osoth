# Caddy front server — แทน Plesk nginx บน 80/443 (สำเนาจริงอยู่ /etc/caddy/Caddyfile บน VPS)
# osoth.com ได้ Let's Encrypt อัตโนมัติ (ต่ออายุเอง) · แอปเสิร์ฟที่ root โดเมน
# rollback: systemctl stop caddy && systemctl unmask nginx && systemctl enable --now nginx

{
	email akkraaiclaude@gmail.com
}

# ---- Plesk mail autoconfig (Outlook/Thunderbird) ----
(mailcfg) {
	@mad path /autodiscover/autodiscover.xml /mail/config-v1.1.xml /.well-known/autoconfig/mail/config-v1.1.xml /email.mobileconfig
	handle @mad {
		rewrite * /mailconfig/
		reverse_proxy 127.0.0.1:8880 {
			header_up X-Host {host}
			header_up X-Request-URI {uri}
		}
	}
}

# ---- โดเมนหลัก: ทั้งโดเมนคือแอป OSOTH (Next.js :3100 + Socket.IO :3102) ----
osoth.com, www.osoth.com, ipv4.osoth.com {
	import mailcfg
	handle /socket.io* {
		reverse_proxy 127.0.0.1:3102
	}
	# URL เก่าใต้ /osoth → ตัด prefix แล้วส่งเข้าโดเมนตรง
	handle_path /osoth* {
		redir https://osoth.com{uri} 302
	}
	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

# ---- Plesk webmail ----
webmail.osoth.com {
	reverse_proxy 127.0.0.1:8880
}

# ---- IP ตรง (HTTP): RISR_hr + Plesk fallback · bookmark เก่า /osoth → โดเมน ----
http://147.50.254.104 {
	handle /RISR_hr* {
		reverse_proxy 127.0.0.1:3001
	}
	handle_path /osoth* {
		redir https://osoth.com{uri} 302
	}
	handle /plesk-site-preview/* {
		reverse_proxy 127.0.0.1:8880 {
			header_up Host plesk-site-preview.local
		}
	}
	handle {
		reverse_proxy 127.0.0.1:7080
	}
}

# ---- IP ตรง (HTTPS, ใบ self-signed ภายใน — browser จะเตือน เป็นปกติของ IP) ----
https://147.50.254.104 {
	tls internal
	handle /RISR_hr* {
		reverse_proxy 127.0.0.1:3001
	}
	handle_path /osoth* {
		redir https://osoth.com{uri} 302
	}
	handle {
		# เดิม nginx ชี้ default 443 → Plesk (8880)
		reverse_proxy 127.0.0.1:8880
	}
}
